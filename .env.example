# ตัวอย่างไฟล์ตั้งค่า: คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ไฟล์ .env.local จะไม่ถูกส่งขึ้น GitHub)

# OpenAI API key สำหรับอ่านสลิป สร้างได้ที่ https://platform.openai.com/api-keys (ต้องเติมเครดิตก่อนใช้)
OPENAI_API_KEY=

# Supabase (ฐานข้อมูล) — ดูที่ Supabase Dashboard → Project Settings → API Keys
SUPABASE_URL=https://xdjnysatannzhsegxtcz.supabase.co
# service_role key: ลับที่สุด ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น ห้ามแชร์/ห้ามใส่ในโค้ด
SUPABASE_SERVICE_ROLE_KEY=

# Microsoft Teams: URL จาก Workflow "Post to a channel when a webhook request is received" (ช่อง Announcement)
TEAMS_WEBHOOK_URL=

# ลิงก์ของแอป (ใช้กับปุ่ม "เปิดแอป" ในการ์ด Teams)
APP_URL=https://expense-app-bbuw.vercel.app
